#!/usr/bin/env bash

. "$(dirname "$0")/tools/platform.sh"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MAKE="$SCRIPT_DIR/tools/bin/$IRON_PLATFORM/amake"

if [ "$(pwd)" = "$SCRIPT_DIR" ] \
   && [ -f "$SCRIPT_DIR/../paint/project.js" ] \
   && [[ " $* " == *" --run "* ]] \
   && [[ " $* " != *" --js "* ]]; then
	cd "$SCRIPT_DIR/../paint" || exit 1
fi

exec "$MAKE" "$SCRIPT_DIR/tools/make.js" "$@"
