#ifdef _ROULETTE
const int DIM_RR = 0;
const int DIM_SELECT = 1;
#else
const int DIM_SELECT = 0;
#endif
#ifdef _TRANSLUCENCY
const int DIM_SELECT2 = DIM_SELECT + 1;
const int DIM_DIR = DIM_SELECT + 2;
#else
const int DIM_DIR = DIM_SELECT + 1;
#endif
#ifdef _ENV_SAMPLING
const int DIM_LIGHT = DIM_DIR + 2;
const int DIM_PER_BOUNCE = DIM_LIGHT + 2;
#else
const int DIM_PER_BOUNCE = DIM_DIR + 2;
#endif

