////
uvec2 scramble_cache;
uvec4 rank_cache;

uint table_word(texture2D tex, int i) {
    int t = (i & 131071) >> 2;
    vec4 c = texelFetch(sampler2D(tex, sampler_linear), ivec2(t & 127, t >> 7), 0);
    return uint(c.r * 255.0) | (uint(c.g * 255.0) << 8) |
           (uint(c.b * 255.0) << 16) | (uint(c.a * 255.0) << 24);
}

uint table_byte(texture2D tex, int i) {
    return (table_word(tex, i) >> uint((i & 3) * 8)) & 255u;
}

void init_sampler(uvec2 pixel_coord, int frame) {
    int pixel_i = (int(pixel_coord.x) + frame * 9) & 127;
    int pixel_j = (int(pixel_coord.y) + frame * 11) & 127;
    int base = (pixel_i + pixel_j * 128) * 8;

    scramble_cache = uvec2(table_word(mytexture_scramble, base),
                           table_word(mytexture_scramble, base + 4));

    rank_cache = uvec4(table_word(mytexture_rank, base),
                       table_word(mytexture_rank, base + 4),
                       table_word(mytexture_rank, base + 8),
                       table_word(mytexture_rank, base + 12));
}

float rand(int pixel_i, int pixel_j, int sample_index, int sample_dimension, int frame) {
    pixel_i += frame * 9;
    pixel_j += frame * 11;
    pixel_i = pixel_i & 127;
    pixel_j = pixel_j & 127;
    sample_index = sample_index & 255;
    sample_dimension = sample_dimension & 255;
    int ranked_sample_index;
    if (sample_dimension < RANK_CACHE_DIMS) {
        int slot = sample_dimension >> 2;
        uint packed = slot == 0 ? rank_cache.x : (slot == 1 ? rank_cache.y : (slot == 2 ? rank_cache.z : rank_cache.w));
        ranked_sample_index = sample_index ^ int((packed >> uint((sample_dimension & 3) * 8)) & 255u);
    }
    else {
        ranked_sample_index = sample_index ^
            int(table_byte(mytexture_rank, sample_dimension + (pixel_i + pixel_j * 128) * 8));
    }
    int value = int(texelFetch(sampler2D(mytexture_sobol, sampler_linear),
        ivec2(ranked_sample_index, sample_dimension), 0).r * 255.0);
    int k = sample_dimension & 7;
    uint packed = k < 4 ? scramble_cache.x : scramble_cache.y;
    value = value ^ int((packed >> uint((k & 3) * 8)) & 255u);
    float v = (0.5 + float(value)) / 256.0;
    return v;
}

float rnd(uvec2 pixel_coord, int sample_index, int dim) {
    return rand(int(pixel_coord.x), int(pixel_coord.y), sample_index, dim, int(constant_buffer.eye.w));
}

vec2 s16_to_f32(uint val) {
    int a = int(val << 16) >> 16;
    int b = int(val & 0xffff0000u) >> 16;
    return vec2(float(a), float(b)) / 32767.0;
}

void unpack_vertex(Vertex v, out vec3 position, out vec3 normal) {
    vec2 zw = s16_to_f32(v.poszw);
    position = vec3(s16_to_f32(v.posxy), zw.x);
    normal = vec3(s16_to_f32(v.nor), zw.y);
}

vec3 srgb_to_linear(vec3 c) {
    return c * (c * (c * 0.305306011 + 0.682171111) + 0.012522878);
}

float luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

void create_basis(vec3 normal, out vec3 tangent, out vec3 binormal) {
    float s = normal.z >= 0.0 ? 1.0 : -1.0;
    float a = -1.0 / (s + normal.z);
    float b = normal.x * normal.y * a;
    tangent = vec3(1.0 + s * normal.x * normal.x * a, s * b, -s * normal.x);
    binormal = vec3(b, s + normal.y * normal.y * a, -normal.y);
}

void create_uv_basis(vec3 p0, vec3 p1, vec3 p2, vec2 uv0, vec2 uv1, vec2 uv2,
                     vec3 n, out vec3 tangent, out vec3 binormal) {
    vec3 e1 = p1 - p0;
    vec3 e2 = p2 - p0;
    vec2 d1 = uv1 - uv0;
    vec2 d2 = uv2 - uv0;
    float det = d1.x * d2.y - d2.x * d1.y;
    if (abs(det) > 1e-12) {
        float r = 1.0 / det;
        vec3 tu = (e1 * d2.y - e2 * d1.y) * r;
        vec3 tv = (e2 * d1.x - e1 * d2.x) * r;
        vec3 t = tu - n * dot(n, tu);
        float tl = dot(t, t);
        if (tl > 1e-16) {
            t *= inversesqrt(tl);
            vec3 b = tv - n * dot(n, tv);
            b -= t * dot(t, b);
            float bl = dot(b, b);
            if (bl > 1e-16) {
                tangent = t;
                binormal = b * inversesqrt(bl);
                return;
            }
        }
    }
    create_basis(n, tangent, binormal);
}

void generate_camera_ray(vec2 screen_pos, out vec3 ray_origin, out vec3 ray_dir, vec3 eye, mat4 inv_vp) {
    screen_pos.y = -screen_pos.y;
    vec4 world = inv_vp * vec4(screen_pos, 0.0, 1.0);
    world.xyz /= world.w;
    ray_origin = eye;
    ray_dir = normalize(world.xyz - ray_origin);
}

vec2 equirect(vec3 normal, float angle) {
    float phi = acos(clamp(normal.z, -1.0, 1.0));
    float theta = atan(-normal.y, normal.x) + PI + angle;
    return vec2(theta / PI2, phi / PI);
}

vec3 cos_weighted_direction(vec3 tangent, vec3 binormal, vec3 n, float u1, float u2) {
    float r = sqrt(u1);
    float phi = PI2 * u2;
    float x = r * cos(phi);
    float y = r * sin(phi);
    float z = sqrt(max(0.0, 1.0 - u1));
    return tangent * x + binormal * y + n * z;
}

vec3 sample_ggx_vndf(vec3 ve, float alpha, float u1, float u2) {
    vec3 vh = normalize(vec3(alpha * ve.x, alpha * ve.y, ve.z));
    float lensq = vh.x * vh.x + vh.y * vh.y;
    vec3 t1 = lensq > 0.0 ? vec3(-vh.y, vh.x, 0.0) * inversesqrt(lensq) : vec3(1.0, 0.0, 0.0);
    vec3 t2 = cross(vh, t1);
    float r = sqrt(u1);
    float phi = PI2 * u2;
    float p1 = r * cos(phi);
    float p2 = r * sin(phi);
    float s = 0.5 * (1.0 + vh.z);
    p2 = (1.0 - s) * sqrt(max(0.0, 1.0 - p1 * p1)) + s * p2;
    vec3 nh = p1 * t1 + p2 * t2 + sqrt(max(0.0, 1.0 - p1 * p1 - p2 * p2)) * vh;
    return normalize(vec3(alpha * nh.x, alpha * nh.y, max(1e-6, nh.z)));
}

float smith_lambda(float cos_theta, float alpha2) {
    float c2 = cos_theta * cos_theta;
    return 0.5 * (sqrt(1.0 + alpha2 * (1.0 - c2) / max(c2, 1e-7)) - 1.0);
}

vec3 f_schlick(vec3 f0, float u) {
    float m = clamp(1.0 - u, 0.0, 1.0);
    float m2 = m * m;
    return f0 + (1.0 - f0) * (m2 * m2 * m);
}

vec3 surface_albedo(vec3 base_color, float metalness) {
    return mix(base_color, vec3(0.0), metalness);
}

vec3 surface_specular(vec3 base_color, float metalness) {
    return mix(vec3(0.04), base_color, metalness);
}

vec3 offset_ray(vec3 p, vec3 ng, vec3 dir) {
    return p + ng * (dot(dir, ng) < 0.0 ? -1e-4 : 1e-4);
}


vec3 env_radiance(vec3 dir) {
    vec2 tex_coord = equirect(dir, constant_buffer.params.y);
    return textureLod(sampler2D(mytexture_env, sampler_linear), tex_coord, 0.0).rgb *
           abs(constant_buffer.params.x);
}

#ifdef _ENV_SAMPLING
vec3 env_dir(vec2 uv) {
    float phi = uv.y * PI;
    float a = uv.x * PI2 - PI - constant_buffer.params.y;
    float s = sin(phi);
    return vec3(s * cos(a), -s * sin(a), cos(phi));
}

vec3 sample_env(float u1, float u2, out float pdf) {
    float fi = u1 * float(ENV_CDF_N);
    int i = clamp(int(fi), 0, ENV_CDF_N - 1);
    float ju = fi - float(i);
    vec4 a = texelFetch(sampler2D(mytexture_env_cdf, sampler_linear),
        ivec2(i % ENV_CDF_W, i / ENV_CDF_W), 0);

    int cell;
    float jv;
    float pdf_uv;
    if (u2 < a.x) {
        cell = i;
        jv = a.x > 0.0 ? u2 / a.x : 0.0;
        pdf_uv = a.z;
    }
    else {
        cell = clamp(int(a.y), 0, ENV_CDF_N - 1);
        jv = a.x < 1.0 ? (u2 - a.x) / (1.0 - a.x) : 0.0;
        pdf_uv = a.w;
    }

    vec2 uv = vec2((float(cell % ENV_CDF_W) + ju) / float(ENV_CDF_W),
                   (float(cell / ENV_CDF_W) + jv) / float(ENV_CDF_H));
    float sin_phi = sin(uv.y * PI);
    pdf = sin_phi > 1e-6 ? pdf_uv / (PI_SQ2 * sin_phi) : 0.0;
    return env_dir(uv);
}

float env_pdf(vec3 dir) {
    if (constant_buffer.params.w == 0.0) {
        return 0.0;
    }
    vec2 uv = equirect(dir, constant_buffer.params.y);
    int x = clamp(int(fract(uv.x) * float(ENV_CDF_W)), 0, ENV_CDF_W - 1);
    int y = clamp(int(uv.y * float(ENV_CDF_H)), 0, ENV_CDF_H - 1);
    float pdf_uv = texelFetch(sampler2D(mytexture_env_cdf, sampler_linear), ivec2(x, y), 0).z;
    float sin_phi = sin(uv.y * PI);
    return sin_phi > 1e-6 ? pdf_uv / (PI_SQ2 * sin_phi) : 0.0;
}

float mis_weight(float pdf_a, float pdf_b) {
    float a = pdf_a * pdf_a;
    float b = pdf_b * pdf_b;
    return a / max(a + b, 1e-9);
}

void bsdf_eval(vec3 wi, vec3 n, vec3 wo, float ndotv, vec3 diffuse_weight, vec3 f0,
               float alpha, float specular_chance, out vec3 f_cos, out float pdf) {
    float ndotl = dot(n, wi);
    if (ndotl <= 0.0) {
        f_cos = vec3(0.0);
        pdf = 0.0;
        return;
    }

    vec3 h = normalize(wo + wi);
    float ndoth = max(dot(n, h), 0.0);
    float vdoth = max(dot(wo, h), 0.0);
    float alpha2 = alpha * alpha;

    float den = ndoth * ndoth * (alpha2 - 1.0) + 1.0;
    float d = alpha2 / max(PI * den * den, 1e-9);
    float lambda_v = smith_lambda(ndotv, alpha2);
    float lambda_l = smith_lambda(ndotl, alpha2);
    vec3 fresnel = f_schlick(f0, vdoth);

    vec3 spec = fresnel * (d / ((1.0 + lambda_v + lambda_l) * max(4.0 * ndotv * ndotl, 1e-9)));
    vec3 diff = diffuse_weight / PI;

    float pdf_spec = d / ((1.0 + lambda_v) * max(4.0 * ndotv, 1e-9));
    float pdf_diff = ndotl / PI;

    f_cos = (diff + spec) * ndotl;
    pdf = specular_chance * pdf_spec + (1.0 - specular_chance) * pdf_diff;
}

bool occluded(vec3 origin, vec3 dir) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query, scene,
        gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
        0xFF, origin, 0.0001, dir, 100.0);
    while (rayQueryProceedEXT(query)) {}
    return rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}
#endif

Vertex get_vertex(uint index) {
    uvec4 d = vertex_data[index];
    Vertex v;
    v.posxy = d.x;
    v.poszw = d.y;
    v.nor = d.z;
    v.tex = d.w;
    return v;
}
////

int process_hit(rayQueryEXT query, inout RayPayload payload, uvec2 pixel_coord, int sample_index, int bounce, vec2 tex_size) {
    int dim = DIM_BOUNCE + bounce * DIM_PER_BOUNCE;

    uint triangle_index = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);

    uint base_index = triangle_index * 3u;

    #ifdef _MULTI
    base_index += uint(rayQueryGetIntersectionInstanceCustomIndexEXT(query, true));
    #endif

    uvec3 indices_sample = uvec3(
        indices[base_index + 0u],
        indices[base_index + 1u],
        indices[base_index + 2u]
    );

    vec2 bary = rayQueryGetIntersectionBarycentricsEXT(query, true);
    vec3 barycentrics = vec3(1.0 - bary.x - bary.y, bary.x, bary.y);

    Vertex v0 = get_vertex(indices_sample[0]);
    Vertex v1 = get_vertex(indices_sample[1]);
    Vertex v2 = get_vertex(indices_sample[2]);

    vec2 vertex_uvs[3];
    vertex_uvs[0] = s16_to_f32(v0.tex);
    vertex_uvs[1] = s16_to_f32(v1.tex);
    vertex_uvs[2] = s16_to_f32(v2.tex);

    vec2 tex_coord = (vertex_uvs[0] * barycentrics.x +
                      vertex_uvs[1] * barycentrics.y +
                      vertex_uvs[2] * barycentrics.z) * constant_buffer.params.z;

    ivec2 utex_coord = ivec2(fract(tex_coord) * tex_size);
    vec4 texpaint0 = texelFetch(sampler2D(mytexture0, sampler_linear), utex_coord, 0);

    vec3 ray_dir = rayQueryGetWorldRayDirectionEXT(query);
    float ray_t = rayQueryGetIntersectionTEXT(query, true);
    vec3 hit = rayQueryGetWorldRayOriginEXT(query) + ray_dir * ray_t;

    vec3 vertex_positions[3];
    vec3 vertex_normals[3];
    unpack_vertex(v0, vertex_positions[0], vertex_normals[0]);
    unpack_vertex(v1, vertex_positions[1], vertex_normals[1]);
    unpack_vertex(v2, vertex_positions[2], vertex_normals[2]);

    vec3 n = normalize(vertex_normals[0] * barycentrics.x +
                       vertex_normals[1] * barycentrics.y +
                       vertex_normals[2] * barycentrics.z);

    vec3 ng = cross(vertex_positions[1] - vertex_positions[0],
                    vertex_positions[2] - vertex_positions[0]);
    ng = dot(ng, ng) > 1e-20 ? normalize(ng) : n;
    ng *= dot(ng, n) < 0.0 ? -1.0 : 1.0;

    vec3 n_object = n;

    #ifdef _MULTI
    mat3 obj_to_world = mat3(rayQueryGetIntersectionObjectToWorldEXT(query, true));
    n = normalize(obj_to_world * n);
    ng = normalize(obj_to_world * ng);
    #endif

    bool back_face = dot(ng, ray_dir) > 0.0;
    if (back_face) {
        ng = -ng;
        n = -n;
    }

    #ifdef _INDIRECT_SKIP_NORMAL
    bool normal_map = bounce == 0;
    #else
    const bool normal_map = true;
    #endif

    vec4 texpaint1 = vec4(0.0);
    if (normal_map) {
        texpaint1 = texelFetch(sampler2D(mytexture1, sampler_linear), utex_coord, 0);
    }

    vec3 texcolor = srgb_to_linear(texpaint0.rgb);

    #ifdef _TRANSLUCENCY
    bool front_face = rayQueryGetIntersectionFrontFaceEXT(query, true);
    if (!front_face) {
        vec3 absorption = pow(max(texcolor, vec3(0.001)), vec3(ray_t * texpaint0.a));
        payload.throughput *= absorption;
    }
    #endif

    #ifdef _EMISSION
    if (int(texpaint1.a * 255.0) % 3 == 1) {
        payload.emission = payload.throughput * texcolor * 100.0;
        return HIT_EMIT;
    }
    #endif

    vec4 texpaint2 = texelFetch(sampler2D(mytexture2, sampler_linear), utex_coord, 0);

    float f = rnd(pixel_coord, sample_index, dim + DIM_SELECT);

    vec3 tangent, binormal;

    #ifdef _TRANSLUCENCY
    if (f > texpaint0.a) {
        float roughness = texpaint2.g;
        create_basis(ray_dir, tangent, binormal);
        vec3 scatter_dir = cos_weighted_direction(tangent, binormal, ray_dir,
                                                             rnd(pixel_coord, sample_index, dim + DIM_DIR),
                                                             rnd(pixel_coord, sample_index, dim + DIM_DIR + 1));
        payload.ray_dir = normalize(mix(ray_dir, scatter_dir, roughness * roughness * 0.5));
        payload.ray_origin = offset_ray(hit, ng, payload.ray_dir);
        return HIT_CONTINUE;
    }

    f = rnd(pixel_coord, sample_index, dim + DIM_SELECT2);
    #endif

    if (normal_map) {
        create_uv_basis(vertex_positions[0], vertex_positions[1], vertex_positions[2],
                        vertex_uvs[0], vertex_uvs[1], vertex_uvs[2], n_object, tangent, binormal);

        #ifdef _MULTI
        tangent = obj_to_world * tangent;
        binormal = obj_to_world * binormal;
        tangent = normalize(tangent - n * dot(n, tangent));
        binormal = normalize(binormal - n * dot(n, binormal) - tangent * dot(tangent, binormal));
        #endif

        if (back_face) {
            binormal = -binormal;
        }

        texpaint1.rgb = normalize(texpaint1.rgb * 2.0 - 1.0);
        texpaint1.g = -texpaint1.g;
        n = normalize(mat3(tangent, binormal, n) * texpaint1.rgb);

        if (dot(n, ng) < 1e-4) {
            n = normalize(n + ng * (1e-4 - dot(n, ng)));
        }
    }

    vec3 wo = -ray_dir;
    float ndotv = dot(n, wo);
    if (ndotv < 1e-3) {
        if (bounce > 0) {
            return HIT_TERMINATE;
        }
        n = normalize(n + wo * (1e-3 - ndotv));
        float ndotg = dot(n, ng);
        if (ndotg < 1e-3) {
            n = normalize(n + ng * (1e-3 - ndotg));
        }
        ndotv = max(dot(n, wo), 1e-3);
    }

    create_basis(n, tangent, binormal);

    vec3 albedo = surface_albedo(texcolor, texpaint2.b);
    vec3 f0 = surface_specular(texcolor, texpaint2.b);
    vec3 fresnel = f_schlick(f0, ndotv);
    vec3 spec_weight = fresnel;
    vec3 diffuse_weight = albedo * (1.0 - fresnel);

    float ls = luma(spec_weight);
    float ld = luma(diffuse_weight);
    float specular_chance = clamp(ls / max(ls + ld, 1e-5), 0.05, 0.995);

    float alpha = max(texpaint2.g * texpaint2.g, 1e-3);

    #ifdef _ENV_SAMPLING
    if (constant_buffer.params.w != 0.0) {
        float pdf_light;
        vec3 wl = sample_env(rnd(pixel_coord, sample_index, dim + DIM_LIGHT),
                             rnd(pixel_coord, sample_index, dim + DIM_LIGHT + 1), pdf_light);
        if (pdf_light > 0.0 && dot(wl, ng) > 0.0) {
            vec3 f_cos;
            float pdf_brdf;
            bsdf_eval(wl, n, wo, ndotv, diffuse_weight, f0, alpha, specular_chance, f_cos, pdf_brdf);
            if (max(max(f_cos.r, f_cos.g), f_cos.b) > 0.0 &&
                !occluded(offset_ray(hit, ng, wl), wl)) {
                payload.radiance += clamp(payload.throughput * f_cos * env_radiance(wl) *
                    (mis_weight(pdf_light, pdf_brdf) / pdf_light), 0.0, 8.0);
            }
        }
    }
    #endif

    float u1 = rnd(pixel_coord, sample_index, dim + DIM_DIR);
    float u2 = rnd(pixel_coord, sample_index, dim + DIM_DIR + 1);

    if (f < specular_chance) {
        float alpha2 = alpha * alpha;
        vec3 v_local = vec3(dot(wo, tangent), dot(wo, binormal), ndotv);
        vec3 h_local = sample_ggx_vndf(v_local, alpha, u1, u2);
        vec3 l_local = reflect(-v_local, h_local);
        if (l_local.z <= 0.0) {
            return HIT_TERMINATE;
        }
        payload.ray_dir = tangent * l_local.x + binormal * l_local.y + n * l_local.z;

        float lambda_v = smith_lambda(v_local.z, alpha2);
        float lambda_l = smith_lambda(l_local.z, alpha2);
        float g2_over_g1 = (1.0 + lambda_v) / (1.0 + lambda_v + lambda_l);
        payload.throughput *= f_schlick(f0, max(dot(v_local, h_local), 0.0)) *
                              (g2_over_g1 / specular_chance);
    }
    else {
        payload.ray_dir = cos_weighted_direction(tangent, binormal, n, u1, u2);
        payload.throughput *= diffuse_weight / (1.0 - specular_chance);
    }

    if (dot(payload.ray_dir, ng) <= 0.0 ||
        max(max(payload.throughput.r, payload.throughput.g), payload.throughput.b) <= 0.0) {
        return HIT_TERMINATE;
    }

    payload.ray_origin = offset_ray(hit, ng, payload.ray_dir);

    #ifdef _ENV_SAMPLING
    {
        vec3 f_cos;
        float pdf_brdf;
        bsdf_eval(payload.ray_dir, n, wo, ndotv, diffuse_weight, f0, alpha, specular_chance, f_cos, pdf_brdf);
        payload.bsdf_pdf = pdf_brdf;
    }
    #endif

    #ifdef _SUBSURFACE
    if (int(texpaint1.a * 255.0) % 3 == 2) {
        float d = min(1.0 / min(ray_t * 2.0, 1.0) / 10.0, 0.5);
        payload.throughput += payload.throughput * d;
        if (f < 0.5) {
            payload.ray_origin += ray_dir * f * 0.001;
        }
    }
    #endif

    return HIT_CONTINUE;
}

void main() {
    uvec2 pixel_coord = gl_GlobalInvocationID.xy;

    ivec2 dimensions = imageSize(render_target);

    if (pixel_coord.x >= uint(dimensions.x) || pixel_coord.y >= uint(dimensions.y)) {
        return;
    }

    init_sampler(pixel_coord, int(constant_buffer.eye.w));

    vec2 tex_size = vec2(textureSize(sampler2D(mytexture0, sampler_linear), 0));

    vec3 accum = vec3(0.0);

    for (int j = 0; j < SAMPLES; ++j) {
        // AA
        vec2 xy = vec2(pixel_coord);
        xy.x += rnd(pixel_coord, j, 0);
        xy.y += rnd(pixel_coord, j, 1);

        vec2 screen_pos = xy / vec2(dimensions) * 2.0 - 1.0;

        vec3 ray_origin;
        vec3 ray_dir;
        generate_camera_ray(screen_pos, ray_origin, ray_dir,
                          constant_buffer.eye.xyz, constant_buffer.inv_vp);

        RayPayload payload;
        payload.throughput = vec3(1.0);
        payload.radiance = vec3(0.0);
        #ifdef _ENV_SAMPLING
        payload.bsdf_pdf = -1.0;
        #endif
        #ifdef _EMISSION
        payload.emission = vec3(0.0);
        #endif

        for (int i = 0; i < DEPTH; ++i) {
            #ifdef _ROULETTE
            if (i >= rr_start) {
                float rr_probability = clamp(max(max(payload.throughput.r, payload.throughput.g), payload.throughput.b), rr_min, rr_max);
                if (rnd(pixel_coord, j, DIM_BOUNCE + i * DIM_PER_BOUNCE + DIM_RR) > rr_probability) {
                    break;
                }
                payload.throughput /= rr_probability;
            }
            #endif

            rayQueryEXT query;
            rayQueryInitializeEXT(query, scene,
                gl_RayFlagsOpaqueEXT,
                0xFF,
                ray_origin,
                0.0001,
                ray_dir,
                100.0);

            while(rayQueryProceedEXT(query)) {}

            if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
                payload.ray_origin = ray_origin;
                payload.ray_dir = ray_dir;

                int result = process_hit(query, payload, pixel_coord, j, i, tex_size);

                #ifdef _EMISSION
                if (result == HIT_EMIT) {
                    payload.radiance += payload.emission;
                    break;
                }
                #endif

                if (result != HIT_CONTINUE) {
                    break;
                }

                ray_origin = payload.ray_origin;
                ray_dir = payload.ray_dir;
            }
            else {
                // Miss
                vec3 texenv;
                float weight = 1.0;
                if (i == 0 && constant_buffer.params.x < 0.0) {
                    texenv = vec3(0.0275);
                }
                else {
                    texenv = env_radiance(ray_dir);
                    #ifdef _ENV_SAMPLING
                    if (payload.bsdf_pdf > 0.0) {
                        weight = mis_weight(payload.bsdf_pdf, env_pdf(ray_dir));
                    }
                    #endif
                }

                payload.radiance += clamp(payload.throughput * texenv * weight, 0.0, 8.0);
                break;
            }
        }

        accum += payload.radiance;
    }

    vec3 color = imageLoad(render_target, ivec2(pixel_coord)).xyz;
    accum = accum / float(SAMPLES);

    #ifdef _RENDER
    float a = 1.0 / (constant_buffer.eye.w + 1.0);
    float b = 1.0 - a;
    color = color * b + accum * a;
    imageStore(render_target, ivec2(pixel_coord), vec4(color, 1.0));
    #else
    if (constant_buffer.eye.w == 0.0) {
        color = accum;
    }
    imageStore(render_target, ivec2(pixel_coord), vec4(mix(color, accum, 1.0 / 4.0), 1.0));
    #endif
}
